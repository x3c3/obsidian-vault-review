{
  "name": "review",
  "version": "2.1.0",
  "description": "Randomly review your vault and track progress",
  "main": "main.js",
  "author": "Mark Ayers",
  "license": "MIT",
  "scripts": {
    "dev": "bun run build.ts --watch",
    "build": "bun run check && bun run build.ts",
    "check": "bun run typecheck && biome check .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome check --write .",
    "version": "bun run version-bump.ts",
    "test": "bun test",
    "deploy": "bun run deploy.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  }
}
